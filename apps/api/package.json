{
  "name": "comicverse-api",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "tsx --test src/storage/image.test.ts src/storage/storage.local.test.ts src/common/util.test.ts src/common/crypto.test.ts src/sources/sources.config.test.ts src/sources/asurascans.normalize.test.ts src/sources/asurascans.provider.test.ts src/sources/weebcentral.normalize.test.ts src/sources/weebcentral.provider.test.ts src/sources/comick.normalize.test.ts src/sources/comick.provider.test.ts src/sources/sources.module.test.ts",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "seed:e2e": "tsx --env-file=.env.test prisma/seed-e2e.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "got-scraping": "3.2.15",
    "helmet": "^7.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "@aws-sdk/client-s3": "^3.650.0",
    "@aws-sdk/s3-request-presigner": "^3.650.0",
    "yauzl": "^3.1.3",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "prisma": "^5.20.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/yauzl": "^2.10.3",
    "@types/multer": "^1.4.12",
    "@nestjs/testing": "^10.4.0",
    "@types/compression": "^1.7.5",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5"
  }
}