NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://comicverse:comicverse@localhost:5432/comicverse

# Frontend origins allowed for CORS & CSRF OriginGuard (comma-separated in production)
# Example for Render/Vercel: https://comicverse-web.onrender.com,https://comicverse.vercel.app
WEB_ORIGIN=http://localhost:3000

# Reverse proxy & cross-origin cookie settings
# Set TRUST_PROXY=1 on Render, Vercel, Railway, Fly.io, or behind Nginx/Cloudflare
TRUST_PROXY=1
# Leave COOKIE_DOMAIN empty when frontend and backend are on different domains (e.g. .onrender.com)
# Only set COOKIE_DOMAIN=.yourdomain.com when both share a custom parent domain.
COOKIE_DOMAIN=
# "lax" for local development; "none" (with HTTPS) when frontend & backend are on separate domains
COOKIE_SAMESITE=lax

# Google OAuth 2.0 / Google Identity Services
# Create a Web Application OAuth Client ID in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Transactional Email (Resend)
# Set MAIL_PROVIDER=resend in production (or "log" in local development)
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM="ComicVerse <noreply@yourdomain.com>"

# Public base URL for this API server (used by local chapter-image storage fallback)
API_PUBLIC_URL=http://localhost:4000/api

# Optional S3-compatible object storage (Cloudflare R2, AWS S3, MinIO)
# Leave empty to use local chapter uploads in apps/api/uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Optional Redis (falls back to in-memory cache when omitted)
REDIS_URL=

# Optional Razorpay billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# External manga/manhwa/manhua sources (WeebCentral, Asura Scans, ComicK)
SOURCES_ENABLED=true
SOURCES_TIMEOUT_MS=10000
# Optional custom User-Agent (must identify ComicVerse, never a browser string)
SOURCES_USER_AGENT=

# Automatic Provider Chapter Synchronization (WeebCentral & AsuraScans)
SOURCE_SYNC_ENABLED=true
SOURCE_SYNC_INTERVAL_MINUTES=30
SOURCE_SYNC_BATCH_SIZE=20
