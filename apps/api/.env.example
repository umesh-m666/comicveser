DATABASE_URL="postgresql://comicverse:comicverse@localhost:5432/comicverse?schema=public"
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3001
# Optional: creates the first admin when running db:seed (password 10+ chars)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password

# Object storage (Cloudflare R2 or S3). For R2 set S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=comicverse-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public CDN origin for reading images; if empty, short-lived signed URLs are used
CDN_BASE_URL=

# Premium memberships (off by default). Get keys from the Razorpay dashboard (use test mode first).
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production / deployment
# TRUST_PROXY=1                 # number of proxies in front of the API
# COOKIE_DOMAIN=.example.com    # share the login cookie between app.example.com and api.example.com
# REDIS_URL=redis://localhost:6379
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM="ComicVerse <no-reply@example.com>"
# DISABLE_JOBS=false            # set true on replicas that should not run scheduled jobs

# External providers. Disabled by default. See docs/EXTERNAL-SOURCES.md before enabling.
SOURCES_ENABLED=false
SOURCES_TIMEOUT_MS=10000
# Identify your app honestly; browser-like User-Agents are rejected.
SOURCES_USER_AGENT=ComicVerse/1.0 (+https://your-site.example)
