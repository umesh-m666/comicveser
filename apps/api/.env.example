NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://comicverse:CHANGE_ME_PASSWORD@localhost:5432/comicverse

# Frontend origins allowed for CORS & CSRF OriginGuard (comma-separated in production)
WEB_ORIGIN=http://localhost:3000

# Reverse proxy & cross-origin cookie settings
TRUST_PROXY=1
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Google OAuth 2.0 / Google Identity Services (Set in deployment environment; never commit real keys)
GOOGLE_CLIENT_ID=

# Transactional Email (Resend) (Set in deployment environment; never commit real API keys)
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM="ComicVerse <noreply@example.com>"

# Public base URL for this API server
API_PUBLIC_URL=http://localhost:4000/api

# Optional S3-compatible object storage (Cloudflare R2, AWS S3, MinIO)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Optional Redis (falls back to in-memory cache when omitted)
REDIS_URL=

# External manga/manhwa/manhua sources (WeebCentral, Asura Scans, ComicK)
SOURCES_ENABLED=true
SOURCES_TIMEOUT_MS=10000
SOURCES_USER_AGENT=

# Automatic Provider Chapter Synchronization (WeebCentral & AsuraScans)
SOURCE_SYNC_ENABLED=true
SOURCE_SYNC_INTERVAL_MINUTES=30
SOURCE_SYNC_BATCH_SIZE=20
