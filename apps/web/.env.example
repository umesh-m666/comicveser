# Backend API URL (must include /api suffix)
# Production example: https://comicverse-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public site URL (used for SEO metadata, canonical links, and sitemaps)
# Production example: https://comicverse-web.onrender.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth 2.0 Client ID (same Web Client ID configured in GOOGLE_CLIENT_ID on the API)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
